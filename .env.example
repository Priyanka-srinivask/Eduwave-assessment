# ---------------------------------------------------------------------------
# Wavy Tutor — example environment file.
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# The app runs fully offline with the defaults below (no key required).
# ---------------------------------------------------------------------------

# Which LLM provider to use: "mock" (offline, default) or "gemini".
LLM_PROVIDER=mock

# --- Only needed when LLM_PROVIDER=gemini ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Reliability tuning (optional; sensible defaults in app/config.py) ---
REQUEST_TIMEOUT_S=20
MAX_RETRIES=2
RETRY_BASE_DELAY_S=0.5

# --- Retrieval / memory (optional) ---
RETRIEVAL_TOP_K=3
HISTORY_WINDOW=8

# --- Persistence (optional) ---
# DB_PATH=./wavy_tutor.db
